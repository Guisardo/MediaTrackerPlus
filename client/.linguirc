{
  "locales": [
    "af",
    "ar",
    "ca",
    "cs",
    "da",
    "de",
    "el",
    "en",
    "es",
    "es-419",
    "fi",
    "fr",
    "he",
    "hu",
    "it",
    "ja",
    "ko",
    "nl",
    "no",
    "pl",
    "pt",
    "ro",
    "ru",
    "sr",
    "sv",
    "tr",
    "uk",
    "vi",
    "zh"
  ],
  "catalogs": [
    {
      "path": "src/i18n/locales/{locale}/translation",
      "include": [
        "src"
      ]
    }
  ],
  "fallbackLocales": {
    "default": "en"
  },
  "format": "po",
  "sourceLocale": "en",
  "compileNamespace": "ts"
}
